# CryptoTrace Configuration Environment File

# Application
APP_NAME=CryptoTrace-Engine
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cryptotrace
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cryptotrace
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Blockchain Data Providers & Credentials
# Never commit real API keys into version control
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
INFURA_PROJECT_ID=
BLOCKSTREAM_API_URL=https://blockstream.info/api
ETHERSCAN_API_URL=https://api.etherscan.io/api

# Connectors and Resiliency
PROVIDER_TIMEOUT_SECONDS=10.0
PROVIDER_MAX_RETRIES=3
PROVIDER_BACKOFF_FACTOR=1.5
PROVIDER_RATE_LIMIT_RPS=5.0

# Fixture / Demo Mode
# When true or when keys are missing, the connector safely leverages deterministic offline fixtures
DEMO_FIXTURE_MODE=true

# Cache
CACHE_TTL_SECONDS=300
CACHE_MAX_ITEMS=5000

# Graph Engine
MAX_GRAPH_HOPS=3
DEFAULT_GRAPH_HOPS=2
MAX_GRAPH_NODES=2500
